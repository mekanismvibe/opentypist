<Window x:Class="OpenTypist.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenTypist Settings" Width="700" Height="700" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="20,2,0,0" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,4" />
        </Style>
        <Style x:Key="Error" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Firebrick" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
        </Style>
    </Window.Resources>
    <TabControl x:Name="Tabs" Margin="10">
        <TabItem Header="General">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,12,16,16">
                    <TextBlock x:Name="StatusText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="LastCheckText" Style="{StaticResource Help}" Margin="0,4,0,0" />

                    <CheckBox x:Name="EnabledBox" Content="Enable completions" Margin="0,16,0,0" />

                    <TextBlock Text="Suggestion length" Style="{StaticResource Heading}" />
                    <ComboBox x:Name="LengthBox" Width="280" HorizontalAlignment="Left" />

                    <TextBlock Text="Show suggestions" Style="{StaticResource Heading}" />
                    <ComboBox x:Name="ConfidenceBox" Width="280" HorizontalAlignment="Left" />
                    <TextBlock x:Name="ConfidenceHelp" Style="{StaticResource Help}" Margin="0,4,0,0" />
                    <CheckBox x:Name="MidLineBox" Content="Suggest in the middle of a line" />
                    <TextBlock Style="{StaticResource Help}" Text="Short suggestions in a small card below the line, leading into the text after the caret." />

                    <TextBlock Text="Accept keys" Style="{StaticResource Heading}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Accept next word" VerticalAlignment="Center" />
                        <Button x:Name="WordKeyButton" Grid.Column="1" MinWidth="140" HorizontalAlignment="Left" Margin="0,2" />
                        <TextBlock Grid.Row="1" Text="Accept whole suggestion" VerticalAlignment="Center" />
                        <Button x:Name="AllKeyButton" Grid.Row="1" Grid.Column="1" MinWidth="140" HorizontalAlignment="Left" Margin="0,2" />
                        <TextBlock Grid.Row="2" Text="Dismiss" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Esc" Margin="4,4" />
                    </Grid>
                    <TextBlock x:Name="KeysMessage" Style="{StaticResource Error}" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource Help}" Margin="0" MaxWidth="460"
                                   Text="These keys only do anything while a suggestion is showing; otherwise they reach the app as usual. Apps that use Tab themselves can get their own keys in the Apps tab." />
                        <Button x:Name="ResetKeysButton" Content="Reset" Margin="12,0,0,0" VerticalAlignment="Top" />
                    </StackPanel>
                    <CheckBox x:Name="TrailingSpaceBox" Content="Add a space after accepting" />

                    <TextBlock Text="Context" Style="{StaticResource Heading}" />
                    <CheckBox x:Name="AppContextBox" Content="Tell the model which app and window you're typing in" Margin="0,0,0,0" />
                    <TextBlock Style="{StaticResource Help}" Text="Everything stays on this PC: the model runs locally and nothing you type is sent anywhere." />

                    <TextBlock Text="This PC" Style="{StaticResource Heading}" />
                    <CheckBox x:Name="GpuBox" Content="Run the model on the graphics card" Margin="0,0,0,0" />
                    <TextBlock Style="{StaticResource Help}" Text="Off: the CPU only (slower, but leaves the graphics card alone)." />
                    <CheckBox x:Name="LoginBox" Content="Start OpenTypist when I sign in" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Autocorrect">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,12,16,16">
                    <CheckBox x:Name="AutocorrectBox" Content="Fix common misspellings as you type" Margin="0" />
                    <CheckBox x:Name="AiTypoBox" Content="Let the AI model fix other typos" />
                    <TextBlock Style="{StaticResource Help}" Margin="0,6,0,0"
                               Text="The model checks typos the lists can't settle (several possible fixes, or a misspelling that is also a real word) and words the Windows spell checker doesn't know, and only fixes one when the correction clearly fits the sentence better. Press Backspace right after a fix to undo it; that word is then never corrected again." />
                    <TextBlock x:Name="SpellLanguagesText" Style="{StaticResource Help}" Margin="0,6,0,0" />

                    <TextBlock Text="Lists" Style="{StaticResource Heading}" />
                    <TextBlock x:Name="ListsText" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="ImportListButton" Content="Import list..." />
                        <Button x:Name="ListsFolderButton" Content="Open lists folder" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Help}" Margin="0,4,0,0"
                               Text="Plain misspelling-&gt;correction lists, or AutoHotkey scripts like AutoCorrect.ahk (the ::typo::fix lines; options *, ?, C and B0)." />
                    <TextBlock x:Name="ImportMessage" Style="{StaticResource Help}" Margin="0,4,0,0" />

                    <TextBlock Text="Never correct" Style="{StaticResource Heading}" />
                    <TextBlock Style="{StaticResource Help}" Margin="0,0,0,4" Text="Words you undid a correction for." />
                    <ListBox x:Name="NeverCorrectList" Height="120" SelectionMode="Extended" />
                    <Button x:Name="RemoveNeverCorrectButton" Content="Remove" HorizontalAlignment="Left" Margin="0,6,0,0" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Snippets">
            <DockPanel Margin="16,12,16,16">
                <StackPanel DockPanel.Dock="Top">
                    <CheckBox x:Name="SnippetsBox" Content="Expand snippets as I type" Margin="0" />
                    <TextBlock Style="{StaticResource Help}" Margin="0,6,0,0"
                               Text="Type a shortcut, then a space or punctuation, and it becomes the full text, in every app. Press Backspace right after to undo. Line breaks in the text are kept (typed as Shift+Enter, so chat apps don't send early)." />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ShortcutBox" FontFamily="Consolas" VerticalAlignment="Top" Padding="2" />
                        <TextBox x:Name="ExpansionBox" Grid.Column="1" Margin="8,0" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="24" MaxHeight="90"
                                 VerticalScrollBarVisibility="Auto" Padding="2" />
                        <Button x:Name="AddSnippetButton" Grid.Column="2" Content="Add" VerticalAlignment="Top" />
                    </Grid>
                    <TextBlock x:Name="SnippetMessage" Style="{StaticResource Help}" Margin="0,4,0,0"
                               Text="For example &quot;@@&quot; becomes your email address, or &quot;;addr&quot; your address." />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="RemoveSnippetButton" Content="Remove selected" />
                        <Button x:Name="ImportSnippetsButton" Content="Import file..." Margin="8,0,0,0" />
                        <TextBlock Style="{StaticResource Help}" Margin="8,4,0,0" Text="One shortcut-&gt;text per line, \n for a line break." />
                    </StackPanel>
                </StackPanel>
                <ListView x:Name="SnippetList" Margin="0,10,0,0" SelectionMode="Extended">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Shortcut" Width="140" DisplayMemberBinding="{Binding Shortcut}" />
                            <GridViewColumn Header="Becomes" Width="440" DisplayMemberBinding="{Binding Preview}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </TabItem>
        <TabItem Header="Apps">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,12,16,16">
                    <TextBlock Text="Turned off in these apps" FontWeight="SemiBold" />
                    <ListBox x:Name="DisabledAppsList" Height="150" Margin="0,6,0,0" SelectionMode="Extended" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="AddDisabledAppButton" Content="Add app..." />
                        <Button x:Name="RemoveDisabledAppButton" Content="Remove" Margin="8,0,0,0" />
                        <Button x:Name="RestoreDisabledAppsButton" Content="Restore defaults" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Help}" Margin="0,4,0,0" Text="Tip: the tray menu has a &quot;Disable in ...&quot; toggle for the app you were just using." />

                    <TextBlock Text="Different accept keys in these apps" Style="{StaticResource Heading}" Margin="0,20,0,4" />
                    <StackPanel x:Name="AppKeysPanel" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="AddAppKeysButton" Content="Add app..." />
                        <TextBlock Style="{StaticResource Help}" Margin="8,4,0,0" Text="For example → and Alt+→ in apps where Tab already does something." />
                    </StackPanel>
                    <TextBlock x:Name="AppKeysMessage" Style="{StaticResource Error}" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Model" x:Name="ModelTab">
            <DockPanel Margin="16,12,16,16">
                <TextBlock DockPanel.Dock="Top" x:Name="HardwareText" TextWrapping="Wrap" />
                <TextBlock DockPanel.Dock="Top" x:Name="DownloadText" TextWrapping="Wrap" Margin="0,6,0,0" />
                <ProgressBar DockPanel.Dock="Top" x:Name="DownloadProgress" Height="6" Margin="0,6,0,0" Maximum="100" Visibility="Collapsed" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="ChooseFileButton" Content="Use a .gguf file..." />
                    <Button x:Name="OpenFolderButton" Content="Open models folder" Margin="8,0,0,0" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel x:Name="ModelList" />
                </ScrollViewer>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
