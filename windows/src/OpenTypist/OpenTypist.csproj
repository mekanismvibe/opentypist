<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>OpenTypist</RootNamespace>
    <AssemblyName>OpenTypist</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>OpenTypist.Program</StartupObject>
    <Version>0.3.0</Version>
    <Product>OpenTypist</Product>
    <Description>OpenTypist</Description>
    <Copyright>MIT License</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- DPI awareness is in app.manifest for WPF; the WinForms analyzer
         (tray icon only) would rather see it in code. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AppIconPath)' != '' and Exists('$(AppIconPath)')">
    <ApplicationIcon>$(AppIconPath)</ApplicationIcon>
  </PropertyGroup>

  <!-- WinForms is only used for the tray icon. Its global usings would make
       Application, MessageBox etc. ambiguous with WPF's, so drop them. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenTypist.Core\OpenTypist.Core.csproj" />
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
  </ItemGroup>

  <!-- llama.dll, ggml*.dll and opentypist_native.dll from windows/build.ps1. -->
  <PropertyGroup>
    <NativeDir Condition="'$(NativeDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\build\wn\runtime\</NativeDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(NativeDir)*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(AppIconPath)" Condition="'$(AppIconPath)' != '' and Exists('$(AppIconPath)')" Link="AppIcon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
